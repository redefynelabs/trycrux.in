# Public address of this site, used in links, the sitemap and social cards.
NEXT_PUBLIC_SITE_URL=https://trycrux.in
# Where the control plane runs. Read by the server only; the browser never sees it.
CONTROL_PLANE_URL=http://localhost:8090
# Cloudflare Turnstile site key (public). Leave empty to run the forms without a captcha. The control plane needs the
# matching secret in CP_TURNSTILE_SECRET.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Replaces the hero video (an .mp4/.webm file URL, or a YouTube/Vimeo embed URL). Empty: the video in public/video.
NEXT_PUBLIC_DEMO_VIDEO_URL=
